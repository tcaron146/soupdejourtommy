rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public reads on everything
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-only uploads
    match /stories/{storyId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "K2iJ43LpAOSTR1BbAO8MYxGhGOO2";
    }

    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "K2iJ43LpAOSTR1BbAO8MYxGhGOO2";
    }

    match /reviews/{reviewId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == "K2iJ43LpAOSTR1BbAO8MYxGhGOO2";
    }
  }
}
